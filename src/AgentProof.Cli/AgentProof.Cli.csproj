<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentProof.Application\AgentProof.Application.csproj" />
    <ProjectReference Include="..\AgentProof.Infrastructure\AgentProof.Infrastructure.csproj" />
    <ProjectReference Include="..\AgentProof.Domain\AgentProof.Domain.csproj" />
    <ProjectReference Include="..\AgentProof.Mcp\AgentProof.Mcp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentproof</ToolCommandName>
    <PackageId>AgentProof</PackageId>
    <Authors>AgentProof contributors</Authors>
    <Description>Local-first deterministic engineering assurance tool for AI coding agents.</Description>
    <PackageTags>ai-agent;mcp;dotnet-tool;verification;engineering;codex;developer-tools</PackageTags>
    <RepositoryUrl>https://github.com/xuanhien010204/AgentProof</RepositoryUrl>
    <PackageProjectUrl>https://github.com/xuanhien010204/AgentProof</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Public preview of deterministic repository analysis, workspace-aware verification, evidence evaluation, CLI, and MCP integration.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
